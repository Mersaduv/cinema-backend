APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8005
APP_TIMEZONE=Asia/Kabul
DB_TIMEZONE=+04:30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cinema
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use sync locally so jobs run inline without queue:work. Production: database + Supervisor.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_DEFAULT_LANGUAGE=fa-IR
TMDB_VERIFY_SSL=false
TMDB_CA_BUNDLE=

# When TMDB has no Persian season/episode overview, auto-translate English (default: MyMemory, no API key).
OVERVIEW_TRANSLATION_ENABLED=true
OVERVIEW_TRANSLATION_DRIVER=auto
OVERVIEW_TRANSLATION_MYMEMORY_EMAIL=
# Optional fallbacks: LibreTranslate URL, then OpenAI-compatible API if api key is set.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
OVERVIEW_TRANSLATION_API_KEY=
OPENAI_API_KEY=
OVERVIEW_TRANSLATION_BASE_URL=https://api.openai.com/v1
OVERVIEW_TRANSLATION_MODEL=gpt-4o-mini
OVERVIEW_TRANSLATION_CACHE_DAYS=90
OVERVIEW_TRANSLATION_TIMEOUT=45
# Local Windows: inherit TMDB_VERIFY_SSL=false or set a CA bundle path.
OVERVIEW_TRANSLATION_VERIFY_SSL=
OVERVIEW_TRANSLATION_CA_BUNDLE=

LIGHTHOUSE_SCHEMA_CACHE_ENABLE=false
LIGHTHOUSE_MAX_QUERY_COMPLEXITY=750
LIGHTHOUSE_MAX_QUERY_DEPTH=10
LIGHTHOUSE_DISABLE_INTROSPECTION=false

NEXT_REVALIDATION_URL=http://cinema.af:3000
NEXT_REVALIDATION_SECRET=

# Internal CDN image ingestion (local dev: store under D:\content, serve as /images/... relative URLs)
CINEMA_IMAGE_STORAGE_ROOT=E:\content
CINEMA_IMAGE_PUBLIC_BASE_URL=
CINEMA_IMAGE_PUBLIC_PREFIX=/images
CINEMA_IMAGE_MAX_DOWNLOAD_SIZE=15728640
CINEMA_IMAGE_DOWNLOAD_TIMEOUT=30
CINEMA_IMAGE_DOWNLOAD_RETRIES=2

# Require login for all /watch pages (GraphQL watchMovie / watchEpisode)
CINEMA_WATCH_AUTH_REQUIRED=false

# Optional HMAC signing for playback manifest URLs
CINEMA_PLAYBACK_SIGNING_SECRET=
CINEMA_PLAYBACK_SESSION_TTL_SECONDS=3600
